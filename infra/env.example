# ================================================================
# infra/env.example  —  Enterprise MCP Hub
# Copy this file to .env in the project root and fill in real values.
# NEVER commit the actual .env file (it is already in .gitignore).
# ================================================================

# ----------------------------------------------------------------
# Go MCP + JSON-RPC Server
# ----------------------------------------------------------------
GO_HTTP_ADDR=":8080"
GO_ENV="development"

# Request deadline for ALL outbound adapter calls (milliseconds).
# When Salesforce exceeds this threshold, the Supabase fallback triggers.
GO_REQUEST_TIMEOUT_MS=8000

# ----------------------------------------------------------------
# PostgreSQL — Supabase remote (preferred) or local Docker
# ----------------------------------------------------------------
# Supabase: Settings → Database → Connection string (URI tab)
# Docker:   postgres://postgres:postgres@localhost:5432/mcp_hub?sslmode=disable
PG_DSN="postgres://postgres:<password>@db.<ref>.supabase.co:5432/postgres"

# ----------------------------------------------------------------
# Jira Cloud — Atlassian REST API v3 (Basic Auth)
# https://id.atlassian.com/manage-profile/security/api-tokens
# ----------------------------------------------------------------

# Your Atlassian Cloud site URL (no trailing slash)
JIRA_BASE_URL="https://<your-domain>.atlassian.net"

# The email address you use to log in to Atlassian
JIRA_EMAIL="you@example.com"

# API token generated at id.atlassian.com → Security → API tokens
JIRA_API_TOKEN="ATATT3xFfGF0..."

# Project key prefix used to build JQL filters (e.g. "EH" → EH-1, EH-2 …)
JIRA_PROJECT_KEY="EH"

# JQL custom-field name that stores the linked Salesforce Account ID.
# Default Jira field name used below; adjust to your instance's field name.
JIRA_SF_ACCOUNT_FIELD="cf[Salesforce Account ID]"

# Set to "false" to call the live Jira REST API.
JIRA_USE_MOCK="false"

# ----------------------------------------------------------------
# Salesforce REST API — OAuth2 Resource Owner Password Credentials
# https://developer.salesforce.com/signup
# ----------------------------------------------------------------

# Your org's instance URL (visible in browser bar after login)
SF_BASE_URL="https://<your-org>.my.salesforce.com"

# Token endpoint — use login.salesforce.com for Developer Edition
SF_LOGIN_URL="https://login.salesforce.com"

# Connected App credentials (Setup → App Manager → Manage Consumer Details)
SF_CLIENT_ID="3MVG9..."
SF_CLIENT_SECRET="ABC123..."

# Your Salesforce username (the email-shaped string you chose on signup)
SF_USERNAME="yourname@sandbox.dev"

# Password + Security Token concatenated (no space).
# Security token: avatar → Settings → Reset My Security Token → check email
SF_PASSWORD="MyPassword123TOKEN456"

# Salesforce REST API version
SF_API_VERSION="v59.0"

# Set to "false" to call the live Salesforce REST API.
SF_USE_MOCK="false"

# ----------------------------------------------------------------
# Supabase Cache — Salesforce Scenario-A fallback
# https://supabase.com → your project → Settings → API
# ----------------------------------------------------------------

# Project URL (Settings → API Keys → Project URL)
SUPABASE_URL="https://<ref>.supabase.co"

# Publishable key (replaces legacy anon key) — Settings → API Keys → Publishable key
# Format: sb_publishable_...
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Secret key (replaces legacy service_role key) — Settings → API Keys → Secret key
# Format: sb_secret_... — KEEP STRICTLY SECRET, never expose to client-side code
SUPABASE_SECRET_KEY="sb_secret_..."

# Set to "true" to enable the Supabase fallback cache path.
SUPABASE_ENABLED="true"

# ----------------------------------------------------------------
# Next.js Frontend
# ----------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL="http://localhost:3000"

# Go JSON-RPC endpoint consumed server-side by Next.js route handlers.
GO_RPC_URL="http://localhost:8080/rpc"
NEXT_PUBLIC_GO_RPC_URL="http://localhost:8080/rpc"
