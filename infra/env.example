# ================================================================
# infra/env.example
# Copy this file to .env (in the project root) and fill in your
# local / staging values. Never commit the actual .env file.
# ================================================================

# ----------------------------------------------------------------
# Go MCP + JSON-RPC Server
# ----------------------------------------------------------------
GO_HTTP_ADDR=":8080"
GO_ENV="development"

# Request deadline for all outbound adapter calls (ms).
# Salesforce fallback engine triggers when this is exceeded.
GO_REQUEST_TIMEOUT_MS=8000

# ----------------------------------------------------------------
# PostgreSQL (local Docker or Supabase free-tier)
# ----------------------------------------------------------------
PG_DSN="postgres://postgres:postgres@localhost:5432/mcp_hub?sslmode=disable"

# If using Supabase Postgres instead of local Docker, point here:
# SUPABASE_PG_URL="postgres://postgres:<password>@db.<ref>.supabase.co:5432/postgres"

# ----------------------------------------------------------------
# Jira Integration (mock / live)
# ----------------------------------------------------------------
JIRA_BASE_URL="https://your-domain.atlassian.net"
JIRA_API_TOKEN="local-dev-mock-token"

# Set to "true" to use static fixture data instead of real API.
# This is the $0-tier default for local dev.
JIRA_USE_MOCK="true"

# ----------------------------------------------------------------
# Salesforce Integration (mock / live)
# ----------------------------------------------------------------
SF_BASE_URL="https://your-instance.salesforce.com"
SF_API_TOKEN="local-dev-mock-token"

# Set to "true" to use static fixture data instead of real API.
SF_USE_MOCK="true"

# ----------------------------------------------------------------
# Supabase Cache (for Salesforce Scenario-A fallback)
# ----------------------------------------------------------------
SUPABASE_URL="https://your-supabase-url.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"

# Set to "true" to enable the cache fallback lookup path.
SUPABASE_ENABLED="true"

# ----------------------------------------------------------------
# Next.js Frontend
# ----------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL="http://localhost:3000"

# The Go JSON-RPC endpoint consumed by Next.js route handlers.
# Note: NEXT_PUBLIC_ prefix is NOT needed here since route handlers
# run server-side; using GO_RPC_URL is safer.
GO_RPC_URL="http://localhost:8080/rpc"
NEXT_PUBLIC_GO_RPC_URL="http://localhost:8080/rpc"
